# ============================================================
# MediaForge Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ─── Supabase (Required) ────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_WORKSPACE_PUBLIC_URL=https://workspace.mediaforge.co
# Optional: force auth callback origin in local/proxy dev, e.g. http://127.0.0.1:8100
VITE_AUTH_REDIRECT_ORIGIN=

# ─── Supabase Edge Function Secrets ─────────────────────────
# These are set via `supabase secrets set` for deployed functions.
# For local dev with `supabase functions serve`, add them here.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
PUBLIC_WORKSPACE_APP_URL=https://workspace.mediaforge.co

# ─── Admin Auth ──────────────────────────────────────────────
# Secret key for signing/verifying admin JWT tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret

# ─── Stripe (Payments) ──────────────────────────────────────
# Found in: Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Found in: Stripe Dashboard > Developers > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Kling AI (Video Generation) ────────────────────────────
# Found in: Kling AI Platform > API credentials
KLING_ACCESS_KEY_ID=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key

# ─── Google AI Studio (Image Gen / TTS) ─────────────────────
# Found in: Google AI Studio > Get API key
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key

# ─── OpenAI (Optional — used in pipeline execution) ─────────
OPENAI_API_KEY=sk-...

# ─── Freepik (Stock Images) ─────────────────────────────────
# Found in: Freepik Developer Dashboard
FREEPIK_API_KEY=your_freepik_api_key

# ─── PostHog (Product Analytics) ────────────────────────────
# Found in: PostHog > Project Settings > Project API Key
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# URL to Asset social downloader (Vercel API)
SOCIAL_DOWNLOADER_SECRET=replace_with_shared_secret
# Optional but recommended for YouTube on hosted serverless IPs.
# Store a Netscape cookies.txt value as base64 to avoid multiline env issues.
SOCIAL_DOWNLOADER_YOUTUBE_COOKIES_B64=
# Optional fallback if your downloader runs behind a proxy.
SOCIAL_DOWNLOADER_PROXY=

# ─── Lovable (Flow Execution Gateway) ───────────────────────
LOVABLE_API_KEY=your_lovable_api_key

POSTHOG_API_KEY=phc_your_posthog_project_api_key
POSTHOG_HOST=https://us.i.posthog.com
